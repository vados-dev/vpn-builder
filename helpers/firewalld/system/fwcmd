#!/usr/bin/env bash

#### fwcmd — помощник с командами firewalld
###########################################
#-> Пути по умолчанию:
#    ------------------
#    Сам скрипт..."/usr/local/bin/fwcmd"
#    Симлинки....."/usr/local/bin/fwreload"
#                 "/usr/local/bin/fwperm"
#                 "/usr/local/bin/fwctl"
#
#-> Установка:
#    ----------
# $(mktemp -d -t install-fwcmd-XXXXXX)
#    Сохранить/переименовать в "install-fwcmd.sh" и запустить.
#    (После подтверждения, будет установлен со всеми симлинками в /usr/local/bin, а сам установщик будет удалён.)
#-> или:
#    "install-fwcmd.sh 1, если в неинтерактивном режиме, с автоподтверждением (1 — да, 0 — нет).
#    "install-fwcmd.sh [0|1] ~/bin", если в PATH.
#
#-> Проверка:
#    ---------
#    "fwcmd --version"....Должен вернуть номер версии
#    "fwcmdreload"........Должен ответить "success"
#
#######################################################
#-> Использование:
#    --------------
#    Сам скрипт один, при установке создаёт симлинки на самого себя.
#    Имя файла (симлинка), является первым аргументом (командой/функцией) при запуске скрипта. 
#    Отсюда:
#    `fwcmd`.............................`firewall-cmd`  - Примет любое количество, любых аргументов.
#                                                          Ответ будет получен от самомго firewall-cmd.
#    `fwreload`.................`firewall-cmd --reload`  - Перечитает правила. Аргументы не требуются.
#    `fwperm`................`firewall-cmd --permanent`  - Добавит/удалит соответствующее правило постоянно.
#                                                          Примет любое количество, любых аргументов.
#                                                          Ответ будет получен от самомго firewall-cmd.
#    `fwchk`.......`firewall-offline-cmd --check-config` - Проверит конфигурацию без применения.
#                                                          Аргументы не требуются.
#    `fwctl`..............`systemctl [команды] [служба]` - Управление служюой firewalld.
#    `[команда] [-h|--help]`...............................Покажет справку по fwcmd.
#
#
#    Управление службой:
#     - `fwctl [аргумент]`
#    Аргументы:
#     ----------
#     -e |enable.........Включить службу.
#     -d |disable........Выключить службу.
#     -en|enable-now.....Включить службу немедленно.
#     -dn|disable-now....Выключить службу немедленно.
#     -s |start..........Запустить службу.
#     -k |stop...........Остановить службу.
#     -r |restart........Перезапустить службу.
#     -rl|reload.........Перечитать и применить конфиги.
#     -st|status.........Показать статус службы.
#     -cc|chk_conf.......Проверить конфиги без применения (оффлайн).
#     -j |journ..........Показать журнал службы.
#     -h |--help.........Эта справка.
#

set -o pipefail

#-> Dynamic vars:
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
SELF_DIR="$(dirname "${SELF}")"
PARENT_DIR="$(dirname "${SELF_DIR}")"

ME_SELF="${SELF##*/}"
ME_CLEAN="${ME_SELF%.*}"

me_name="${0##*/}"
ARGS=( "$@" )

#-> Static vars:
PROGRAM="fwcmd"
BIN_DIR="/usr/local/bin"
SYMLINKS=( "fwreload" "fwperm" "fwchk" "fwctl" )
assume_yes=0 # Автоматически отвечать "да" на все вопросы (для скриптов/cron)
DEF_OK_RE="true|success|^0$"
DEF_FAIL_RE="false|Error|^1$"
TG_NOTIFY=1 # слать неожиданные ответы в телеграм вместо молчаливого отказа
OUT=""      # вывод последней команды из overlay_cmd
RC=0        # реальный код последней команды из overlay_cmd

fw_exec="firewall-cmd"

chk_cmd=firewall-offline-cmd
chk_args="--check-config"

fw_service="firewalld.service"
fwctl_exec="systemctl"

# Выводить отладочные сообщения
dbg=1

[ "$TG_NOTIFY" = 1 ] && source /etc/awg-bot.conf

if [ -t 0 ]; then
    cmd()        { printf '[\033[1;33m✨\033[0m]#: ' >&2; printf '%q ' "$@" >&2; printf '\033[0m\n' >&2; }
    answer_box() { printf '\033[1;33m ⚡ %s\033[0m\n' "$*"; }
    ok()        { local rc="$?" m="${1:-}"; [ -z "$m" ] && m="rc=${rc}"; [ "$rc" -eq 0 ] && printf '\033[1;32m √ %s\033[0m\n' "$m" || printf '\033[1;31m ✘ %s\033[0m\n' "$m"; return "$rc"; }
    tg_ask()     { [ -n "${BOT_TOKEN:-}" ] && [ -n "${ADMIN_ID:-}" ] || die "tg_ask: не заданы BOT_TOKEN/ADMIN_ID"; curl -s "https://api.telegram.org/bot${BOT_TOKEN}/sendMessage" -d chat_id="${ADMIN_ID}" -d text="${1:-Требуется подтверждение}" >/dev/null; die "tg_ask: ожидание ответа через getUpdates — не реализовано (заглушка)"; }
    log()  { printf '\033[1;34m 📋 INFO:\033[0;8m [%s] - %s.\033[0m\n' "$me_name" "$*"; }
    warn() { printf '\033[1;33m ⚡ WARN:\033[0;1m [%s] - %s.\033[0m\n' "$me_name" "$*" >&2; }
    err()  { printf '\033[0;31m ⚫ ERROR:\033[0;1m [%s] - %s!\033[0m\n' "$me_name" "$*" >&2; }
    die()  { printf '\033[1;31m ❌ CRITICAL:\033[0;1m [%s] - %s!\033[0m\n' "$me_name" "$*" >&2; exit 1; }
    prompt_yn() { local d="${2,,}"; [ "$d" = "y" ] && printf '\033[1m%s [Y/n]:\033[0m ' "$1" || printf '\033[1m%s [y/N]:\033[0m ' "$1"; }
else
    cmd()        { printf '[*]#: ' >&2; printf '%q ' "$@" >&2; printf '\n' >&2; }    
    answer_box() { printf ' ⚡ %s\n' "$*"; }
    ok()        { local rc="$?" m="${1:-}"; [ -z "$m" ] && m="rc=${rc}"; [ "$rc" -eq 0 ] && printf ' √ %s\n' "$m" || printf ' ✘ %s\n' "$m"; return "$rc"; }
    tg_ask()     { [ -n "${BOT_TOKEN:-}" ] && [ -n "${ADMIN_ID:-}" ] || die "tg_ask: не заданы BOT_TOKEN/ADMIN_ID"; curl -s "https://api.telegram.org/bot${BOT_TOKEN}/sendMessage" -d chat_id="${ADMIN_ID}" -d text="${1:-Требуется подтверждение}" >/dev/null; die "tg_ask: ожидание ответа через getUpdates — не реализовано (заглушка)"; }
    log()  { printf '[INFO] [%s] - %s.\n' "$me_name" "$*"; }
    warn() { printf '[WARN] [%s] - %s.\n' "$me_name" "$*" >&2; }
    err()  { printf '[ERROR] [%s] - %s!\n' "$me_name" "$*" >&2; }
    die()  { printf '[CRITICAL] [%s] - %s!\n' "$me_name" "$*" >&2; exit 1; }
    prompt_yn() { local d="${2,,}"; [ "$d" = "y" ] && printf '%s [Y/n]: ' "$1" || printf '%s [y/N]: ' "$1"; }
fi

ask() { local a d="${2:-Y}"; if [ -t 0 ]; then read -r -p "$(prompt_yn "${1:-Продолжить?}" "$d")" a < /dev/tty; a="${a:-$d}"; case "${a,,}" in y|yes) return 0;; *) return 1;; esac; else tg_ask "$1"; fi; }
overlay_cmd() { local fork="$1"; shift; [ "$1" = "--" ] && shift; local out rc v msg; out="$("$@")"; rc=$?; RC=$rc; OUT="$out"; if [ "$fork" = "--" ]; then if [ "$rc" -eq 0 ] && [[ "$out" =~ (${DEF_OK_RE}) ]]; then v=0; msg="$out"; elif [ "$rc" -eq 0 ] && [ -z "$out" ]; then v=0; msg="пусто (уже выполнено)"; elif [[ "$out" =~ (${DEF_FAIL_RE}) ]] || [ "$rc" -ne 0 ]; then v=1; msg="$out"; else [ "$dbg" -eq 1 ] && answer_box "Неожиданный вывод: ${out:-пусто}"; [ "${TG_NOTIFY:-0}" = 1 ] && tg_notify "${me_name}: неожиданный вывод: ${out:-пусто}"; v=1; msg=""; fi; [ "$v" -eq 0 ]; ok "$msg"; return "$v"; fi; [[ "$(declare -p "$fork" 2>/dev/null)" == "declare -A"* ]] || die "overlay_cmd: '$fork' — не ассоциативный массив"; local tk="${fork}[true]" fk="${fork}[false]" ak="${fork}[answer]"; local ok_re="${!tk}" fail_re="${!fk}" ans_re="${!ak}"; if [ "$rc" -eq 0 ] && [ -n "$ok_re" ] && [[ "$out" =~ ($ok_re) ]]; then v=0; elif [ -n "$fail_re" ] && [[ "$out" =~ ($fail_re) ]]; then v=1; elif [ "$rc" -ne 0 ]; then v=1; else v=2; fi; return "$v"; }
input_cmd()   { [ "$dbg" -eq 1 ] && cmd "${@:3}"; overlay_cmd "$@"; }
run_cmd()     { [ "$dbg" -eq 1 ] && cmd "$@"; "$@"; }
tg_notify()   { [ -n "${BOT_TOKEN:-}" ] && [ -n "${ADMIN_ID:-}" ] || die "tg_notify: не заданы BOT_TOKEN/ADMIN_ID"; curl -s "https://api.telegram.org/bot${BOT_TOKEN}/sendMessage" -d chat_id="${ADMIN_ID}" -d text="$*" >/dev/null; }

confirm() { local a; [ "${assume_yes:-0}" = "1" ] && { log "Автоподтверждение: -y"; return 0; }; [ -t 0 ] || [ -t 1 ] || die "Нет интерактивного терминала — используйте -y"; read -r -p "$(prompt_yn "${1:-Уверены?}" "${2:-n}")" a < /dev/tty || die "Поток ввода закрыт — используйте -y"; a="${a:-${2:-n}}"; case "${a,,}" in y|yes) return 0;; *) warn "Отменено пользователем"; exit 0;; esac; }

fwcmd_install() {
    [ "$1" = "-h" ] || [ "$1" = "--help" ] && { install_usage; exit 0; }
    [[ -n "$1" ]] && assume_yes="$1"; [[ -n "$2" ]] && BIN_DIR="$2"
    local src
    if [ -r "$SELF" ] && [ -s "$SELF" ]; then src="$SELF"; else
        src="$(mktemp -t install-fwcmd-XXXXXX)" || die "Не удалось создать временный файл"
        cat > "$src" || die "Не удалось прочитать сам скрипт из stdin (curl | bash)"
        chmod 755 "$src"; trap 'rm -f "$src"' EXIT
        log "Источник установки: stdin -> ${src}"
    fi
    [ -d "$BIN_DIR" ] || mkdir -p "$BIN_DIR" || die "Не могу создать ${BIN_DIR}"
    if [ -f "$BIN_DIR/$PROGRAM" ]; then
        cmp -s "$src" "$BIN_DIR/$PROGRAM" && { ok "Уже установлена та же версия: ${BIN_DIR}/${PROGRAM}"; exit 0; }
        confirm "Установлена другая версия — заменить на текущую?" "y" && ok "Замена подтверждена" || { ok "Обновление отменено"; exit 0; }
    else
        confirm "Установить ${PROGRAM} в ${BIN_DIR}?" "y" && ok "Установка подтверждена" || { ok "Установка отменена"; exit 0; }
    fi
    install -m 755 "$src" "$BIN_DIR/$PROGRAM" || die "Ошибка установки ${PROGRAM}"
    log "установлена в ${BIN_DIR}/${PROGRAM}"
    log "создаю симлинки..."
    local fail=0
    for link in "${SYMLINKS[@]}"; do
        if ln -sfn "$PROGRAM" "${BIN_DIR}/${link}" 2>/dev/null; then
            log "- ${link} -> ${PROGRAM}"
        elif [ -e "${BIN_DIR}/${link}" ] && [ ! -L "${BIN_DIR}/${link}" ]; then
            if rm -rf "${BIN_DIR:?}/${link}" 2>/dev/null; then
                if ln -sfn "$PROGRAM" "${BIN_DIR}/${link}"; then
                    log "- ${link} -> ${PROGRAM} (перезаписан)"
                else
                    warn "Не смог создать симлинк ${BIN_DIR}/${link} после удаления"; fail=$((fail+1))
                fi
            else
                warn "Не смог удалить ${BIN_DIR}/${link} (не файл/каталог? права?)"; fail=$((fail+1))
            fi
        else
            warn "Не смог создать симлинк ${BIN_DIR}/${link} — проверьте права на ${BIN_DIR}"
            fail=$((fail+1))
        fi
    done
    [ -f "$SELF" ] && [ "${SELF%/*}" != "$BIN_DIR" ] && { rm -f "$SELF"; log "Установщик удалён: ${SELF}"; }
    trap - EXIT
    if [ "$fail" -eq 0 ]; then ok "Установка завершена."; else err "Установлено частично: ${fail} симлинк(ов) не создан(о) — перечислено выше"; exit 1; fi
}

usage() { sed -n '25,43p' "${SELF}" | sed 's/^# \{0,1\}//'; }
install_usage() { sed -n '2,25p' "${SELF}" | sed 's/^# \{0,1\}//'; }
ctl_usage() { sed -n '42,60p' "${SELF}" | sed 's/^# \{0,1\}//'; }

fwctl_cmd() {
    [ $# -gt 0 ] || { err "Пустые аргументы"; ctl_usage; exit 2; }
    case $1 in
        -e |enable)       run_cmd $fwctl_exec enable $fw_service ;;
        -d |disable)      run_cmd $fwctl_exec disable $fw_service ;;
        -en|enable-now)   run_cmd $fwctl_exec enable --now $fw_service ;;
        -dn|disable-now)  run_cmd $fwctl_exec disable --now $fw_service ;;
        -s |start)        run_cmd $fwctl_exec start $fw_service ;;
        -k |stop)         run_cmd $fwctl_exec stop $fw_service ;;
        -r |restart)      run_cmd $fwctl_exec restart $fw_service ;;
        -rl|reload)       input_cmd "$fw_exec" --reload ;;
        -st|status)       run_cmd $fwctl_exec status $fw_service ;;   # сырой вывод, краски systemctl сохранены
        -cc|chk_conf)     input_cmd "$chk_cmd" "$chk_args" ;;
        -j |journ)        run_cmd journalctl -xeu $fw_service ;;        
        -h |--help)       ctl_usage ;;
          *) { err "Неизвестный аргумент '$1'"; ctl_usage; exit 2; } ;;
    esac
}

fw_cmd() {
    [ "${me_name}" != "install-fwcmd.sh" ] && ([ "$1" = "-h" ] || [ "$1" = "--help" ]) && { usage; exit 0; }
    case "${me_name}" in
        fwreload)           input_cmd -- "$fw_exec" --reload ;;
        fwperm) [ $# -eq 0 ] && { err "fwperm требует аргументов"; usage; exit 2; }; declare -A RESP=([true]="success" [false]="error|fail" [answer]=""); input_cmd RESP -- "$fw_exec" --permanent "$@" && ok "success" || { [ "$?" -eq 2 ] && answer_box "Ответ команды: $OUT" || ok "отказ"; }; unset RESP ;;
        fwchk)              input_cmd -- "$chk_cmd" "$chk_args" ;;
        fwctl)              fwctl_cmd "$@" ;;
        install-fwcmd.sh)   fwcmd_install "$@" ;;
        *)                  run_cmd "$fw_exec" "$@" ;;
    esac
}

fw_cmd "$@"
